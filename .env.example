# ─── Multi-akun ──────────────────────────────────────────────────────────────
# Folder basis sesi: sesi akun <id> disimpan di <AUTH_BASE_DIR>/<id>/
# (folder auth_info/ JANGAN dibagikan ke siapa pun — setara akun WhatsApp).
AUTH_BASE_DIR=auth_info

# File registry akun (daftar akun + nomor HP tiap akun).
# Akun baru ditambahkan dari MENU console (pilihan 1) dan otomatis
# tercatat di sini, jadi tetap ada setelah restart.
ACCOUNTS_FILE=data/accounts.json

# Login: PAIRING CODE SAJA. Tidak ada QR di versi ini — nomor HP tiap
# akun dimasukkan lewat menu console saat akun dibuat / di-pairing,
# lalu kode pairing tampil di dashboard untuk dimasukkan ke HP akun itu.

# ─── Grup target (percakapan antar-bot) ──────────────────────────────────────
# JID grup WhatsApp tujuan, format: 120363xxxxxxxxxx@g.us
# Cara dapat JID: jalankan bot yang sudah jadi admin/peserta, atau pakai
# tools grup — JID juga tercetak di log saat bot berhasil gabung via invite.
GROUP_JID=

# Kode undangan grup ATAU link utuhnya (salah satu saja cukup, bersama
# GROUP_JID lebih baik). Dengan ini akun BARU yang selesai pairing bisa
# gabung grup SENDIRI tanpa ditambahkan manual.
# Contoh link: https://chat.whatsapp.com/AbCdEfGhIjKlMnOpQrSt
GROUP_INVITE_LINK=
# GROUP_INVITE_CODE=

# Percakapan antar-bot di dalam grup target.
GROUP_CHAT_ENABLED=true
# Jeda acak antar sesi percakapan (menit) dan jumlah giliran per sesi.
GROUP_CHAT_INTERVAL_MIN_MINUTES=20
GROUP_CHAT_INTERVAL_MAX_MINUTES=45
GROUP_CHAT_MIN_TURNS=4
GROUP_CHAT_MAX_TURNS=8
# Jeda ekstra antar giliran bicara dalam satu sesi (milidetik).
GROUP_CHAT_TURN_GAP_MIN_MS=4000
GROUP_CHAT_TURN_GAP_MAX_MS=12000

# ─── Jadwal aktif (scheduler) ────────────────────────────────────────────────
# Zona waktu untuk semua jam di bawah ini.
BOT_TIMEZONE=Asia/Jakarta

# Jendela jam aktif, format "HH:MM-HH:MM", pisahkan dengan koma bila lebih
# dari satu. Di luar jendela ini SEMUA bot TIDUR: pesan masuk diabaikan
# total dan percakapan grup berhenti. Jendela boleh melewati tengah malam,
# contoh: 21:00-01:00
ACTIVE_WINDOWS=08:00-12:00,16:00-20:00

# ─── AI (text-only, Google Gemini via @google/genai) ─────────────────────────
# Kosongkan GEMINI_API_KEY bila belum punya — bot tetap jalan dengan balasan
# cadangan (fallback) kasual bawaan, tanpa memanggil API sama sekali.
# Ambil key gratis di Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai (bawaan sesuai spesifikasi).
GEMINI_MODEL=gemini-2.5-flash

# Anti repetisi & variasi organik:
# temperature agak tinggi = pilihan kata dinamis, tidak kaku.
GEMINI_TEMPERATURE=0.9
# presencePenalty menghukum topik/kata yang sudah muncul -> variasi subjek baru.
GEMINI_PRESENCE_PENALTY=0.6
# frequencyPenalty menghukum pengulangan kata yang sama dalam satu balasan.
GEMINI_FREQUENCY_PENALTY=0.5
# Batas token keluaran per balasan (balasan chat pendek saja).
GEMINI_MAX_OUTPUT_TOKENS=120

# ─── Perilaku human-like ─────────────────────────────────────────────────────
# Jeda berpikir acak sebelum mulai mengetik (milidetik).
THINK_DELAY_MIN_MS=3000
THINK_DELAY_MAX_MS=7000

# Status "mengetik" dihitung dari panjang balasan: ms per karakter,
# dengan batas maksimal (default 6000 = 6 detik).
TYPING_MS_PER_CHAR=40
TYPING_MAX_MS=6000

# Tandai pesan sebagai dibaca (centang biru) saat jam aktif, sebelum membalas.
MARK_AS_READ=true

# Balas pesan di grup LAIN selain grup target? Default mati.
# (Grup target selalu dilayani: satu akun dipilih menjawab pesan manusia,
# dan percakapan antar-bot berjalan di sana.)
RESPOND_TO_GROUPS=false

# Level log pino untuk Baileys: silent | error | warn | info | debug
LOG_LEVEL=silent
