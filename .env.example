# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Nomor yang akan di-pairing, format internasional TANPA "+" dan tanpa spasi.
# Contoh Indonesia: 62812xxxxxxx
BOT_PHONE_NUMBER=6281234567890

# Folder sesi login (jangan dibagikan ke siapa pun — setara akun WhatsApp).
AUTH_DIR=auth_info

# ─── Jadwal aktif (scheduler) ────────────────────────────────────────────────
# Zona waktu untuk semua jam di bawah ini.
BOT_TIMEZONE=Asia/Jakarta

# Jendela jam aktif, format "HH:MM-HH:MM", pisahkan dengan koma bila lebih
# dari satu. Di luar jendela ini bot TIDUR: pesan masuk diabaikan total
# (tidak dibaca, tidak dibalas). Jendela boleh melewati tengah malam,
# contoh: 21:00-01:00
ACTIVE_WINDOWS=08:00-12:00,16:00-20:00

# ─── AI (text-only, OpenAI-compatible) ───────────────────────────────────────
# Kosongkan AI_API_KEY bila belum punya — bot tetap jalan dengan balasan
# cadangan (fallback) kasual bawaan, tanpa memanggil API sama sekali.
AI_API_KEY=

# Groq:       https://api.groq.com/openai/v1
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter: https://openrouter.ai/api/v1        (bisa Claude/GPT/dll)
# OpenAI:     https://api.openai.com/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Contoh model: llama-3.3-70b-versatile (Groq) / gemini-2.0-flash (Gemini)
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.9
AI_MAX_TOKENS=120

# ─── Perilaku human-like ─────────────────────────────────────────────────────
# Jeda berpikir acak sebelum mulai mengetik (milidetik).
THINK_DELAY_MIN_MS=3000
THINK_DELAY_MAX_MS=7000

# Status "mengetik" dihitung dari panjang balasan: ms per karakter,
# dengan batas maksimal (default 6000 = 6 detik).
TYPING_MS_PER_CHAR=40
TYPING_MAX_MS=6000

# Tandai pesan sebagai dibaca (centang biru) saat jam aktif, sebelum membalas.
MARK_AS_READ=true

# Balas chat grup juga? Untuk warming up akun pribadi, default mati:
# bot hanya membalas chat personal (1-on-1).
RESPOND_TO_GROUPS=false

# Level log pino untuk Baileys: silent | error | warn | info | debug
LOG_LEVEL=silent
